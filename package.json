{
  "name": "webrunner",
  "version": "0.1.0",
  "description": "MCP server for web search, page fetching, deep research and live browsing",
  "type": "module",
  "license": "MIT",
  "author": "krybaby7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krybaby7/webrunner.git"
  },
  "bin": {
    "webrunner": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "eval:research": "RUN_EVALS=1 node --import tsx test/evals/research/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "1.32",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^29.1.1",
    "playwright": "1.56.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
